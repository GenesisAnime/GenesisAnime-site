{
  "name": "genesisanime",
  "version": "0.1.0",
  "private": true,
  "description": "GenesisAnime — TurkAnime arşiv verisi üzerine kurulu, tamamen statik anime izleme sitesi",
  "scripts": {
    "veri": "node --no-warnings tools/export-data.mjs",
    "link:tara": "node --no-warnings tools/link-tara.mjs",
    "link:durum": "node --no-warnings tools/link-tara.mjs --durum",
    "link:test": "node --no-warnings tools/link-tara.mjs --kendini-test",
    "link:bildirim": "node --no-warnings tools/bildirim-cek.mjs",
    "api:test": "node --no-warnings tools/api-uctan-uca.mjs",
    "simge:uret": "node --no-warnings tools/simge-uret.mjs",
    "veri:anilist": "node --no-warnings tools/enrich-anilist.mjs",
    "veri:rapor": "node --no-warnings tools/report-data.mjs",
    "test": "node --no-warnings --test \"tools/testler/*.test.mjs\"",
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "yayin:hazirla": "node --no-warnings tools/yayin-hazirla.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
